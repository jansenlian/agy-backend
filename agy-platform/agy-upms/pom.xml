<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.greatmap.agy</groupId>
        <artifactId>agy-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>agy-upms</artifactId>
    <name>agy-upms</name>
    <description>平台唯一主运行模块与权限基础服务 (运行端口: 9200)</description>

    <dependencies>
        <!-- 基础核心框架依赖 (全量包含 Web, Security, JDBC, Redis, Swagger, EasyExcel 等) -->
        <dependency>
            <groupId>com.greatmap.agy</groupId>
            <artifactId>agy-common-web</artifactId>
        </dependency>

        <!-- 聚合内部模块 -->
        <dependency>
            <groupId>com.greatmap.agy</groupId>
            <artifactId>agy-auth</artifactId>
        </dependency>

        <!-- 持久层 Starter (Mapper 模块必需依赖，用于触发 SqlSessionFactory 自动绑定) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 数据库驱动与 Flyway 迁移 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot Starter Test (JUnit 5, Mockito, AssertJ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.greatmap.agy.AgyUpmsApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
