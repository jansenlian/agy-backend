<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.greatmap.agy</groupId>
        <artifactId>agy-geo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>geo-dwg</artifactId>
    <packaging>jar</packaging>

    <name>geo-dwg</name>
    <description>CAD(DWG/DXF)空间数据解析与矢量图斑提取类库 (基于 LibreDWG 工具链的纯净 Jar 类库)</description>

    <dependencies>
        <!-- 引入核心几何底座 -->
        <dependency>
            <groupId>com.greatmap.agy</groupId>
            <artifactId>geo-core</artifactId>
        </dependency>

        <!-- Spring 核心上下文与 Web 接口契约 (提供 MultipartFile 与 @Service，零 Tomcat 容器) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- 测试组件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>
                        -XX:+EnableDynamicAgentLoading
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
